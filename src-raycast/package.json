{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "justanothermusicclient",
  "title": "JustAnotherMusicClient",
  "description": "Communicate with JustAnotherMusicClient to easily find and play music",
  "icon": "extension-icon.png",
  "author": "technomarc3",
  "platforms": [
    "Windows",
    "macOS"
  ],
  "categories": [
    "Media"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "search-music",
      "title": "Search music",
      "subtitle": "",
      "description": "Search for specific music or playlist",
      "mode": "view"
    },
    {
      "name": "next",
      "title": "Next",
      "subtitle": "",
      "description": "Skip current song",
      "mode": "no-view"
    },
    {
      "name": "pause-resume",
      "title": "Pause/Resume",
      "subtitle": "",
      "description": "Pause/Resume current song",
      "mode": "no-view"
    },
    {
      "name": "previous",
      "title": "Previous",
      "subtitle": "",
      "description": "Play previous song",
      "mode": "no-view"
    }
  ],
  "tools": [],
  "dependencies": {
    "@raycast/api": "^2.10.1",
    "@raycast/utils": "^2.2.7"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "predev": "copy ..\\assets\\img\\Logo.png .\\assets\\extension-icon.png",
    "prebuild": "copy ..\\assets\\img\\Logo.png .\\assets\\extension-icon.png",
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  }
}
